<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<StackPane style="-fx-background-color: linear-gradient(to bottom right, #0f0f1a, #1a1a2e, #16213e);"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.auctionreal.RegisterController">

    <VBox alignment="CENTER" spacing="14.0" maxWidth="400.0">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="30.0"/>
        </padding>
        <children>
            <!-- Icon + Tiêu đề -->
            <Label text="📝" style="-fx-font-size: 38px;"/>

            <Label text="ĐĂNG KÝ TÀI KHOẢN"
                   style="-fx-text-fill: #e0e0ff; -fx-font-size: 22px; -fx-font-weight: bold;"/>

            <!-- Khung hướng dẫn -->
            <VBox spacing="5.0"
                  style="-fx-background-color: #1a2540; -fx-border-color: #3a5070;
                         -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14;">
                <children>
                    <Label text="📌 Hướng dẫn đăng ký:"
                           style="-fx-text-fill: #7ec8e3; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                    <Label text="• Tên đăng nhập: 4–20 ký tự, chỉ dùng chữ, số, dấu _"
                           style="-fx-text-fill: #aaaacc; -fx-font-size: 11px;"/>
                    <Label text="• Mật khẩu: ít nhất 4 ký tự, không có khoảng trắng"
                           style="-fx-text-fill: #aaaacc; -fx-font-size: 11px;"/>
                    <Label text="• Chọn vai trò: NGƯỜI MUA (đấu giá) hoặc NGƯỜI BÁN (đăng sản phẩm)"
                           style="-fx-text-fill: #aaaacc; -fx-font-size: 11px; -fx-wrap-text: true;"/>
                    <Label text="• Vai trò không thể thay đổi sau khi đăng ký!"
                           style="-fx-text-fill: #ffaa44; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                </children>
            </VBox>

            <!-- Tên đăng nhập -->
            <VBox spacing="4.0">
                <children>
                    <Label text="Tên đăng nhập"
                           style="-fx-text-fill: #9090bb; -fx-font-size: 12px;"/>
                    <TextField fx:id="txtUsername" promptText="Ví dụ: nguyen_van_a"
                               maxWidth="360.0"
                               style="-fx-background-color: #1e1e30; -fx-text-fill: #e0e0e0;
                                      -fx-prompt-text-fill: #555577; -fx-border-color: #333355;
                                      -fx-border-radius: 8; -fx-background-radius: 8;
                                      -fx-padding: 10 14; -fx-font-size: 14px;"/>
                </children>
            </VBox>

            <!-- Mật khẩu -->
            <VBox spacing="4.0">
                <children>
                    <Label text="Mật khẩu (ít nhất 4 ký tự)"
                           style="-fx-text-fill: #9090bb; -fx-font-size: 12px;"/>
                    <PasswordField fx:id="txtPassword" promptText="Nhập mật khẩu..."
                                  maxWidth="360.0"
                                  style="-fx-background-color: #1e1e30; -fx-text-fill: #e0e0e0;
                                         -fx-prompt-text-fill: #555577; -fx-border-color: #333355;
                                         -fx-border-radius: 8; -fx-background-radius: 8;
                                         -fx-padding: 10 14; -fx-font-size: 14px;"/>
                </children>
            </VBox>

            <!-- Chọn vai trò -->
            <VBox spacing="4.0">
                <children>
                    <Label text="Vai trò của bạn"
                           style="-fx-text-fill: #9090bb; -fx-font-size: 12px;"/>
                    <ComboBox fx:id="cmbRole"
                              promptText="── Chọn vai trò ──"
                              maxWidth="360.0"
                              style="-fx-background-color: #1e1e30; -fx-text-fill: #e0e0e0;
                                     -fx-border-color: #333355; -fx-border-radius: 8;
                                     -fx-background-radius: 8; -fx-font-size: 14px;"/>
                    <!-- Mô tả role -->
                    <Label fx:id="lblRoleDesc" text=""
                           style="-fx-text-fill: #6fa8dc; -fx-font-size: 11px; -fx-wrap-text: true;"/>
                </children>
            </VBox>

            <!-- Thông báo lỗi -->
            <Label fx:id="lblMessage" text=""
                   maxWidth="360.0" wrapText="true"
                   style="-fx-font-size: 12px; -fx-text-fill: #ff7777;"/>

            <!-- Nút đăng ký -->
            <Button mnemonicParsing="false" onAction="#handleRegister"
                    prefWidth="360.0" prefHeight="42.0"
                    style="-fx-background-color: linear-gradient(to right, #43a047, #66bb6a);
                           -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px;
                           -fx-background-radius: 8; -fx-cursor: hand;"
                    text="✅  TẠO TÀI KHOẢN" />

            <!-- Link đăng nhập -->
            <HBox alignment="CENTER" spacing="5.0">
                <children>
                    <Label text="Đã có tài khoản?"
                           style="-fx-text-fill: #8888aa; -fx-font-size: 13px;"/>
                    <Hyperlink text="Đăng nhập ngay" onAction="#handleGoToLogin"
                               style="-fx-text-fill: #6366f1; -fx-font-size: 13px; -fx-border-color: transparent;"/>
                </children>
            </HBox>

        </children>
    </VBox>
</StackPane>
