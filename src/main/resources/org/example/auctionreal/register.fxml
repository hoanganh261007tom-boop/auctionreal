<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<!--
  StackPane thay vì AnchorPane để tự động căn giữa nội dung khi resize.
-->
<StackPane style="-fx-background-color: linear-gradient(to bottom right, #0f0f1a, #1a1a2e, #16213e);"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.auctionreal.RegisterController">

    <VBox alignment="CENTER" spacing="18.0" maxWidth="320.0">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0"/>
        </padding>
        <children>
            <!-- Icon -->
            <Label text="📝" style="-fx-font-size: 42px;"/>

            <!-- Tiêu đề của màn hình -->
            <Label text="ĐĂNG KÝ HỆ THỐNG"
                   style="-fx-text-fill: #e0e0ff; -fx-font-size: 22px; -fx-font-weight: bold;"/>

            <Label text="Tạo tài khoản mới để bắt đầu."
                   style="-fx-text-fill: #8888aa; -fx-font-size: 13px;"/>

            <Region prefHeight="5.0"/>

            <TextField fx:id="txtId" promptText="Nhập ID (ví dụ: U001)"
                       maxWidth="300.0"
                       style="-fx-background-color: #1e1e30; -fx-text-fill: #e0e0e0; -fx-prompt-text-fill: #666688; -fx-border-color: #333355; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 14px;"/>

            <TextField fx:id="txtUsername" promptText="Nhập Tên người dùng"
                       maxWidth="300.0"
                       style="-fx-background-color: #1e1e30; -fx-text-fill: #e0e0e0; -fx-prompt-text-fill: #666688; -fx-border-color: #333355; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 14px;"/>

            <PasswordField fx:id="txtPassword" promptText="Mật khẩu (ít nhất 4 ký tự)"
                           maxWidth="300.0"
                           style="-fx-background-color: #1e1e30; -fx-text-fill: #e0e0e0; -fx-prompt-text-fill: #666688; -fx-border-color: #333355; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 14px;"/>

            <Button mnemonicParsing="false" onAction="#handleRegister"
                    prefWidth="300.0" prefHeight="40.0"
                    style="-fx-background-color: linear-gradient(to right, #43a047, #66bb6a); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 8; -fx-cursor: hand;"
                    text="Tiếp theo" />

            <Region prefHeight="3.0"/>

            <HBox alignment="CENTER" spacing="5.0">
                <children>
                    <Label text="Đã có tài khoản?"
                           style="-fx-text-fill: #8888aa; -fx-font-size: 13px;"/>
                    <Hyperlink text="Đăng nhập" onAction="#handleGoToLogin"
                               style="-fx-text-fill: #6366f1; -fx-font-size: 13px; -fx-border-color: transparent;"/>
                </children>
            </HBox>

        </children>
    </VBox>
</StackPane>
