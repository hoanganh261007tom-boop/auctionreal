<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="700.0"
            style="-fx-background-color: #0f0f1a;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.auctionreal.RoleSelectionController">
    <children>
        <VBox alignment="CENTER" layoutX="50.0" layoutY="40.0"
              prefHeight="320.0" prefWidth="600.0" spacing="25.0"
              style="-fx-background-color: #1a1a2e; -fx-background-radius: 20;
                     -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 10);">
            <children>

                <!-- Tiêu đề -->
                <VBox alignment="CENTER" spacing="8.0">
                    <children>
                        <Label text="BẠN LÀ AI?"
                               style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 28px;"/>
                        <Label fx:id="lblWelcome"
                               text="Chào mừng! Vui lòng chọn vai trò để tiếp tục."
                               style="-fx-text-fill: #666666; -fx-font-size: 14px;"/>
                    </children>
                </VBox>

                <!-- 3 nút ngang hàng -->
                <HBox alignment="CENTER" spacing="20.0">
                    <children>

                        <!-- Nút Seller -->
                        <Button onAction="#handleSelectSeller"
                                prefHeight="120.0" prefWidth="160.0"
                                text="NGƯỜI BÁN&#10;(SELLER)"
                                textAlignment="CENTER"
                                style="-fx-background-color: #fb8c00; -fx-text-fill: white;
                                       -fx-background-radius: 15; -fx-cursor: hand;
                                       -fx-font-weight: bold; -fx-font-size: 16px;"/>

                        <!-- Nút Bidder -->
                        <Button onAction="#handleSelectBidder"
                                prefHeight="120.0" prefWidth="160.0"
                                text="NGƯỜI MUA&#10;(BIDDER)"
                                textAlignment="CENTER"
                                style="-fx-background-color: #1e88e5; -fx-text-fill: white;
                                       -fx-background-radius: 15; -fx-cursor: hand;
                                       -fx-font-weight: bold; -fx-font-size: 16px;"/>

                        <!-- Nút Admin -->
                        <Button onAction="#handleSelectAdmin"
                                prefHeight="120.0" prefWidth="160.0"
                                text="QUẢN TRỊ&#10;(ADMIN)"
                                textAlignment="CENTER"
                                style="-fx-background-color: #6a1b9a; -fx-text-fill: white;
                                       -fx-background-radius: 15; -fx-cursor: hand;
                                       -fx-font-weight: bold; -fx-font-size: 16px;"/>

                    </children>
                </HBox>

                <!-- Nút quay lại -->
                <Button onAction="#handleBack"
                        text="Quay lại trang đăng ký"
                        style="-fx-background-color: transparent; -fx-text-fill: #9e9e9e;
                               -fx-underline: true; -fx-cursor: hand;"/>

            </children>
        </VBox>
    </children>
</AnchorPane>
