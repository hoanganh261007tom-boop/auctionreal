<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<!--
  Vị trí file: src/main/resources/org/example/auctionreal/role-selection.fxml
  fx:controller: Phải khớp chính xác với class RoleSelectionController bạn sẽ tạo.
-->

<AnchorPane prefHeight="400.0" prefWidth="600.0" style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.auctionreal.RoleSelectionController">
    <children>
        <VBox alignment="CENTER" layoutX="75.0" layoutY="50.0" prefHeight="300.0" prefWidth="450.0" spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 10);">
            <children>
                <VBox alignment="CENTER" spacing="8.0">
                    <children>
                        <Label text="BẠN LÀ AI?">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblWelcome" text="Chào mừng! Vui lòng chọn vai trò để tiếp tục." textFill="#666666">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>
                    </children>
                </VBox>

                <HBox alignment="CENTER" spacing="30.0">
                    <children>
                        <!-- Nút dành cho Người bán (Seller) -->
                        <Button onAction="#handleSelectSeller" prefHeight="120.0" prefWidth="160.0" style="-fx-background-color: #fb8c00; -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand; -fx-font-weight: bold;" text="NGƯỜI BÁN&#10;(SELLER)" textAlignment="CENTER">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Button>

                        <!-- Nút dành cho Người đấu giá (Bidder) -->
                        <Button onAction="#handleSelectBidder" prefHeight="120.0" prefWidth="160.0" style="-fx-background-color: #1e88e5; -fx-text-fill: white; -fx-background-radius: 15; -fx-cursor: hand; -fx-font-weight: bold;" text="NGƯỜI MUA&#10;(BIDDER)" textAlignment="CENTER">
                            <font>
                                <Font size="16.0" />
                            </font>
                        </Button>
                    </children>
                </HBox>

                <Button onAction="#handleBack" style="-fx-background-color: transparent; -fx-text-fill: #9e9e9e; -fx-underline: true; -fx-cursor: hand;" text="Quay lại trang đăng ký" />
            </children>
        </VBox>
    </children>
</AnchorPane>
