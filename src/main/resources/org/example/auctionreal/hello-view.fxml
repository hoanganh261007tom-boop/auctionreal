<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.paint.Color?>

<AnchorPane prefHeight="500.0" prefWidth="600.0"
            style="-fx-background-color: linear-gradient(to bottom right, #0f0f1a, #1a1a2e, #16213e);"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.auctionreal.HelloController">
    <children>
        <VBox alignment="CENTER" spacing="18.0"
              AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
              AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">
            <padding>
                <Insets bottom="40.0" left="150.0" right="150.0" top="40.0"/>
            </padding>
            <children>
                <!-- Icon / Emoji -->
                <Label text="🔐" style="-fx-font-size: 42px;"/>

                <!-- Tiêu đề -->
                <Label text="ĐĂNG NHẬP HỆ THỐNG"
                       style="-fx-text-fill: #e0e0ff; -fx-font-size: 22px; -fx-font-weight: bold;"/>

                <Label text="Chào mừng bạn quay lại! Đăng nhập để tiếp tục."
                       style="-fx-text-fill: #8888aa; -fx-font-size: 13px;"/>

                <!-- Spacer -->
                <Region prefHeight="10.0"/>

                <!-- Username -->
                <TextField fx:id="txtUsername" promptText="Tên đăng nhập"
                           maxWidth="300.0"
                           style="-fx-background-color: #1e1e30; -fx-text-fill: #e0e0e0; -fx-prompt-text-fill: #666688; -fx-border-color: #333355; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 14px;"/>

                <!-- Password -->
                <PasswordField fx:id="txtPassword" promptText="Mật khẩu"
                               maxWidth="300.0"
                               style="-fx-background-color: #1e1e30; -fx-text-fill: #e0e0e0; -fx-prompt-text-fill: #666688; -fx-border-color: #333355; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10 14; -fx-font-size: 14px;"/>

                <!-- Thông báo lỗi / thành công -->
                <Label fx:id="lblMessage" text="" style="-fx-font-size: 13px; -fx-text-fill: #ff7777;"/>

                <!-- Nút Đăng nhập -->
                <Button text="Đăng nhập" onAction="#onLoginButtonClick"
                        prefWidth="300.0" prefHeight="40.0"
                        style="-fx-background-color: linear-gradient(to right, #4a6cf7, #6366f1); -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 8; -fx-cursor: hand;"/>

                <!-- Spacer -->
                <Region prefHeight="5.0"/>

                <!-- Link đến Đăng ký -->
                <HBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label text="Chưa có tài khoản?"
                               style="-fx-text-fill: #8888aa; -fx-font-size: 13px;"/>
                        <Hyperlink text="Đăng ký ngay" onAction="#onGoToRegister"
                                   style="-fx-text-fill: #6366f1; -fx-font-size: 13px; -fx-border-color: transparent;"/>
                    </children>
                </HBox>

            </children>
        </VBox>
    </children>
</AnchorPane>
