<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<!--
  bidder-dashboard.fxml
  Màn hình dành cho Người Mua / Người Đặt Giá (Bidder).
  Bidder có thể xem tất cả vật phẩm đang đấu giá, tìm kiếm, và nhấn vào để vào phòng đấu giá.
  fx:controller: Liên kết với BidderDashboardController.java
-->
<AnchorPane prefHeight="700.0" prefWidth="1000.0"
            style="-fx-background-color: #0f0f1a;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.auctionreal.BidderDashboardController">
    <children>

        <!-- ===== THANH TIÊU ĐỀ TRÊN CÙNG ===== -->
        <HBox layoutX="0" layoutY="0" prefWidth="1000" prefHeight="60"
              alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: #1a1a2e; -fx-padding: 0 30 0 30;">
            <children>
                <Label text="⚡ AUCTION LIVE"
                       style="-fx-text-fill: #f0c040; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="│  BIDDER DASHBOARD"
                       style="-fx-text-fill: #4ab0f0; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- Số dư ví của Bidder -->
                <Label text="💰 Số dư:"
                       style="-fx-text-fill: #555577; -fx-font-size: 13px;"/>
                <Label fx:id="lblBalance"
                       style="-fx-text-fill: #4af0a0; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                <!-- Thông tin người dùng -->
                <Label fx:id="lblUserInfo"
                       style="-fx-text-fill: #aaaacc; -fx-font-size: 13px;"/>
                <Button text="← Đăng xuất" onAction="#handleBack"
                        style="-fx-background-color: transparent; -fx-text-fill: #aaaacc; -fx-font-size: 13px; -fx-cursor: hand; -fx-underline: true;"/>
            </children>
        </HBox>

        <!-- ===== NỘI DUNG CHÍNH ===== -->
        <VBox layoutX="20" layoutY="80" prefWidth="960" prefHeight="600" spacing="16">
            <children>

                <!-- ===== THANH TÌM KIẾM & BỘ LỌC ===== -->
                <HBox spacing="12" alignment="CENTER_LEFT"
                      style="-fx-background-color: #1a1a2e; -fx-background-radius: 12; -fx-padding: 16 20 16 20;">
                    <children>

                        <!-- Ô tìm kiếm -->
                        <TextField fx:id="txtSearch"
                                   promptText="🔍  Tìm kiếm vật phẩm (VD: Rolex, iPhone...)"
                                   prefHeight="42"
                                   prefWidth="300"
                                   style="-fx-background-color: #12122a; -fx-text-fill: #ffffff; -fx-prompt-text-fill: #444466; -fx-border-color: #333355; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 0 14 0 14; -fx-font-size: 13px;"/>

                        <!-- Lọc theo danh mục -->
                        <ComboBox fx:id="cmbFilterCategory"
                                  promptText="Danh mục"
                                  prefHeight="42"
                                  prefWidth="150"
                                  style="-fx-background-color: #12122a; -fx-text-fill: #ffffff; -fx-border-color: #333355; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px;"/>

                        <!-- Lọc theo giá -->
                        <ComboBox fx:id="cmbFilterPrice"
                                  promptText="Khoảng giá"
                                  prefHeight="42"
                                  prefWidth="160"
                                  style="-fx-background-color: #12122a; -fx-text-fill: #ffffff; -fx-border-color: #333355; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px;"/>

                        <!-- Lọc theo trạng thái -->
                        <ComboBox fx:id="cmbFilterStatus"
                                  promptText="Trạng thái"
                                  prefHeight="42"
                                  prefWidth="150"
                                  style="-fx-background-color: #12122a; -fx-text-fill: #ffffff; -fx-border-color: #333355; -fx-border-radius: 8; -fx-background-radius: 8; -fx-font-size: 13px;"/>

                        <!-- Nút tìm -->
                        <Button text="Tìm kiếm" onAction="#handleSearch"
                                prefHeight="42"
                                style="-fx-background-color: #f0c040; -fx-text-fill: #0f0f1a; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 0 20 0 20;"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- Nút xem đặt giá của tôi -->
                        <Button text="📋  Lịch sử của tôi" onAction="#handleMyBids"
                                prefHeight="42"
                                style="-fx-background-color: #1e2a3a; -fx-text-fill: #4ab0f0; -fx-font-size: 12px; -fx-background-radius: 8; -fx-cursor: hand; -fx-padding: 0 16 0 16;"/>

                    </children>
                </HBox>

                <!-- ===== THỐNG KÊ NHANH ===== -->
                <HBox spacing="14">
                    <children>
                        <!-- Đang diễn ra -->
                        <VBox alignment="CENTER" prefWidth="220"
                              style="-fx-background-color: #1a1a2e; -fx-background-radius: 12; -fx-padding: 18;">
                            <children>
                                <Label text="● ĐANG ĐẤU GIÁ"
                                       style="-fx-text-fill: #ff4444; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                <Label fx:id="lblLiveCount" text="0"
                                       style="-fx-text-fill: #ff4444; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                                <Label text="phiên trực tiếp"
                                       style="-fx-text-fill: #444466; -fx-font-size: 11px;"/>
                            </children>
                        </VBox>
                        <!-- Sắp kết thúc -->
                        <VBox alignment="CENTER" prefWidth="220"
                              style="-fx-background-color: #1a1a2e; -fx-background-radius: 12; -fx-padding: 18;">
                            <children>
                                <Label text="⏰ SẮP KẾT THÚC"
                                       style="-fx-text-fill: #f0c040; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                <Label fx:id="lblEndingSoon" text="0"
                                       style="-fx-text-fill: #f0c040; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                                <Label text="kết thúc trong 30 phút"
                                       style="-fx-text-fill: #444466; -fx-font-size: 11px;"/>
                            </children>
                        </VBox>
                        <!-- Tôi đang dẫn đầu -->
                        <VBox alignment="CENTER" prefWidth="220"
                              style="-fx-background-color: #1a1a2e; -fx-background-radius: 12; -fx-padding: 18;">
                            <children>
                                <Label text="🏆 TÔI ĐANG DẪN ĐẦU"
                                       style="-fx-text-fill: #4af0a0; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                <Label fx:id="lblLeading" text="0"
                                       style="-fx-text-fill: #4af0a0; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                                <Label text="phiên đang dẫn"
                                       style="-fx-text-fill: #444466; -fx-font-size: 11px;"/>
                            </children>
                        </VBox>
                        <!-- Tổng vật phẩm có sẵn -->
                        <VBox alignment="CENTER" prefWidth="220"
                              style="-fx-background-color: #1a1a2e; -fx-background-radius: 12; -fx-padding: 18;">
                            <children>
                                <Label text="🏷 TỔNG VẬT PHẨM"
                                       style="-fx-text-fill: #aaaacc; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                                <Label fx:id="lblTotalItems" text="0"
                                       style="-fx-text-fill: #aaaacc; -fx-font-size: 28px; -fx-font-weight: bold;"/>
                                <Label text="vật phẩm có sẵn"
                                       style="-fx-text-fill: #444466; -fx-font-size: 11px;"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- ===== KKVỰC CHÍNH: DANH SÁCH + PANEL CHI TIẾT ===== -->
                <HBox spacing="16" VBox.vgrow="ALWAYS">
                    <children>

                        <!-- DANH SACH VAT PHAM ben trai -->
                        <VBox prefWidth="530" VBox.vgrow="ALWAYS" spacing="10"
                              style="-fx-background-color: #1a1a2e; -fx-background-radius: 16; -fx-padding: 20;">
                            <children>

                                <!-- Tiêu đề -->
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <children>
                                        <Label text="🏷 VẬT PHẨM ĐANG ĐẤU GIÁ"
                                               style="-fx-text-fill: #aaaacc; -fx-font-size: 14px; -fx-font-weight: bold;"/>
                                        <Region HBox.hgrow="ALWAYS"/>
                                        <!-- Dropdown sắp xếp -->
                                        <ComboBox fx:id="cmbSort"
                                                  promptText="Sắp xếp..."
                                                  prefHeight="32"
                                                  prefWidth="160"
                                                  style="-fx-background-color: #12122a; -fx-text-fill: #ffffff; -fx-border-color: #333355; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 12px;"/>
                                    </children>
                                </HBox>

                                <Separator style="-fx-background-color: #2a2a4a;"/>

                                <!-- ListView vật phẩm -->
                                <ListView fx:id="listAuctionItems"
                                          VBox.vgrow="ALWAYS"
                                          onMouseClicked="#handleItemSelected"
                                          style="-fx-background-color: #12122a; -fx-background-radius: 10; -fx-border-color: #222244; -fx-border-radius: 10; -fx-control-inner-background: #12122a; -fx-font-size: 13px;"/>

                                <!-- Phân trang (đơn giản) -->
                                <HBox alignment="CENTER" spacing="8">
                                    <children>
                                        <Button text="◀" onAction="#handlePrevPage"
                                                prefWidth="36" prefHeight="32"
                                                style="-fx-background-color: #12122a; -fx-text-fill: #aaaacc; -fx-background-radius: 6; -fx-cursor: hand;"/>
                                        <Label fx:id="lblPage" text="Trang 1 / 1"
                                               style="-fx-text-fill: #555577; -fx-font-size: 12px;"/>
                                        <Button text="▶" onAction="#handleNextPage"
                                                prefWidth="36" prefHeight="32"
                                                style="-fx-background-color: #12122a; -fx-text-fill: #aaaacc; -fx-background-radius: 6; -fx-cursor: hand;"/>
                                    </children>
                                </HBox>

                            </children>
                        </VBox>

                        <!-- PANEL CHI TIET VAT PHAM ben phai -->
                        <VBox prefWidth="400" VBox.vgrow="ALWAYS" spacing="14"
                              style="-fx-background-color: #1a1a2e; -fx-background-radius: 16; -fx-padding: 22;">
                            <children>

                                <!-- Badge trạng thái -->
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <children>
                                        <Label fx:id="lblStatusBadge" text="● ĐANG ĐẤU GIÁ"
                                               style="-fx-text-fill: #ff4444; -fx-font-size: 12px; -fx-font-weight: bold; -fx-background-color: #3a1a1a; -fx-background-radius: 20; -fx-padding: 4 12 4 12;"/>
                                        <Label fx:id="lblSessionId" text="Phiên #---"
                                               style="-fx-text-fill: #444466; -fx-font-size: 12px;"/>
                                    </children>
                                </HBox>

                                <!-- Tên vật phẩm được chọn -->
                                <Label fx:id="lblItemName" text="Chọn một vật phẩm để xem"
                                       wrapText="true"
                                       style="-fx-text-fill: #ffffff; -fx-font-size: 20px; -fx-font-weight: bold;"/>

                                <!-- Người bán -->
                                <Label fx:id="lblSellerName" text="Người bán: ---"
                                       style="-fx-text-fill: #9999bb; -fx-font-size: 13px;"/>

                                <!-- Placeholder hình ảnh vật phẩm -->
                                <StackPane prefHeight="170" prefWidth="356"
                                           style="-fx-background-color: #12122a; -fx-background-radius: 12;">
                                    <children>
                                        <VBox alignment="CENTER" spacing="8">
                                            <children>
                                                <Label fx:id="lblItemEmoji" text="🏷"
                                                       style="-fx-font-size: 64px;"/>
                                                <Label fx:id="lblItemCategory" text="---"
                                                       style="-fx-text-fill: #444466; -fx-font-size: 12px;"/>
                                            </children>
                                        </VBox>
                                    </children>
                                </StackPane>

                                <!-- Mô tả -->
                                <Label fx:id="lblDescription" text="Chưa có thông tin chi tiết..."
                                       wrapText="true"
                                       style="-fx-text-fill: #777799; -fx-font-size: 12px;"/>

                                <!-- Tags trạng thái -->
                                <HBox fx:id="hboxTags" spacing="8"/>

                                <!-- Giá hiện tại -->
                                <VBox spacing="4"
                                      style="-fx-background-color: #0d1f0d; -fx-background-radius: 10; -fx-padding: 14;">
                                    <children>
                                        <Label text="GIÁ CAO NHẤT HIỆN TẠI"
                                               style="-fx-text-fill: #4af0a0; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                                        <Label fx:id="lblCurrentPrice" text="---"
                                               style="-fx-text-fill: #ffffff; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                                        <Label fx:id="lblTopBidder" text="Chưa có ai đặt giá"
                                               style="-fx-text-fill: #4af0a0; -fx-font-size: 12px;"/>
                                    </children>
                                </VBox>

                                <!-- Đồng hồ đếm ngược -->
                                <VBox alignment="CENTER" spacing="3"
                                      style="-fx-background-color: #12122a; -fx-background-radius: 10; -fx-padding: 12;">
                                    <children>
                                        <Label text="KẾT THÚC TRONG"
                                               style="-fx-text-fill: #444466; -fx-font-size: 10px;"/>
                                        <Label fx:id="lblCountdown" text="-- : -- : --"
                                               style="-fx-text-fill: #f0c040; -fx-font-size: 28px; -fx-font-weight: bold; -fx-font-family: 'Monospaced';"/>
                                    </children>
                                </VBox>

                                <!-- Nút THAM GIA ĐẤU GIÁ (to, nổi bật) -->
                                <Button fx:id="btnJoinAuction"
                                        text="⚡  THAM GIA ĐẤU GIÁ NGAY"
                                        onAction="#handleJoinAuction"
                                        prefHeight="50"
                                        prefWidth="999"
                                        disable="true"
                                        style="-fx-background-color: #f0c040; -fx-text-fill: #0f0f1a; -fx-font-weight: bold; -fx-font-size: 15px; -fx-background-radius: 10; -fx-cursor: hand;"/>

                                <!-- Nút theo dõi (yêu thích) -->
                                <Button fx:id="btnWatchlist"
                                        text="🔖  Thêm vào danh sách theo dõi"
                                        onAction="#handleWatchlist"
                                        prefHeight="38"
                                        prefWidth="999"
                                        style="-fx-background-color: #1e1e3a; -fx-text-fill: #aaaacc; -fx-font-size: 12px; -fx-background-radius: 8; -fx-cursor: hand;"/>

                            </children>
                        </VBox>

                    </children>
                </HBox>

            </children>
        </VBox>

    </children>
</AnchorPane>
